# 複製此檔為 .env 並填入正確設定

# JWT 密鑰（正式環境請換成隨機長字串）
SECRET_KEY=ibms-dev-secret-change-in-production
TOKEN_TTL_HOURS=8

# 資料庫設定

# PostgreSQL (預設)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/ibms

# MS SQL Server Express
# DATABASE_URL=mssql+aioodbc://sa:YourPassword@localhost\SQLEXPRESS/ibms?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Web Push VAPID 金鑰（勿提交真實金鑰；未設定則每次重啟自動產生，既有訂閱會失效）
# 產生方式（在 backend/ 下執行，輸出可直接貼進 .env）：python -c "import sys;sys.path.insert(0,'.');from app.push_service import generate_vapid_keys as g;p,b=g();print('VAPID_PRIVATE_KEY=' + chr(34) + p.replace(chr(10), chr(92)+'n') + chr(34));print('VAPID_PUBLIC_KEY=' + b)"
# VAPID_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# VAPID_PUBLIC_KEY=B...
# VAPID_EMAIL=admin@ibms.com
